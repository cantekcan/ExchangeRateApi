## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Original source: https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/ActiveState ActiveGo)
*.userprefs

# Mono auto-generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Release]/
[Releases]/
x64/
x86/
[AR][Mm]/
[AR][Mm]64/
bld/
[Bin]/
[Ob]j/
Log/
Logs/

# Visual Studio 2015/2017/2019/2022 cache directory
.vs/
# Uncomment if you have tasks that create the project's static web assets in wwwroot
# wwwroot/lib/

# MSTest test Results
[Te]st[Ou]tput*/
[Te]st[Re]sult*/

# NUnit
/*.VisualState.xml

# Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# Web tools
node_modules/
/jspm_packages/
/bower_components/

# Serverless Web Assets
.serverless/

# OS-generated files
.DS_Store
Thumbs.db
